<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <% if (typeof errors !== 'undefined' && errors) { %>
    <ul class="notice">
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/new-organization" method="POST">
    <label for="name">Organization Name</label>

    <input
      type="text"
      id="name"
      name="name"
      value="<%= typeof organization !== 'undefined' ? organization.name : '' %>"
      maxlength="100"
      required
    />

    <label for="description">Description</label>

    <textarea
      id="description"
      name="description"
      required
    ><%= typeof organization !== 'undefined' ? organization.description : '' %></textarea>

    <label for="contact_email">Contact Email</label>

    <input
      type="email"
      id="contact_email"
      name="contact_email"
      value="<%= typeof organization !== 'undefined' ? organization.contact_email : '' %>"
      required
    />

    <label for="logo_filename">Logo Filename</label>

    <input
      type="text"
      id="logo_filename"
      name="logo_filename"
      value="<%= typeof organization !== 'undefined' ? organization.logo_filename : '' %>"
    />

    <button type="submit">Create Organization</button>
  </form>
</main>

<%- include('partials/footer') %>