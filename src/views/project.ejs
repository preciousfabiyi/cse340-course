<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p><strong>Description:</strong> <%= project.description %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        }) %>
    </p>

    <p><strong>Location:</strong> <%= project.location %></p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <strong>Categories:</strong>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        <% }) %>
    </p>

    <% if (user) { %>
        <section class="volunteer-section">
            <h2>Volunteer for This Project</h2>

            <% if (volunteering) { %>
                <p>You are volunteering for this project. Thank you for offering your help!</p>

                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit">Remove Me as a Volunteer</button>
                </form>
            <% } else { %>
                <p>Would you like to help with this service project?</p>

                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit">Volunteer for This Project</button>
                </form>
            <% } %>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>