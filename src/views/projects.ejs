<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>
        <a href="/new-project">Create New Service Project</a>
    </p>

    <h2>Upcoming Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </strong>
                -
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
                -
                <a href="/edit-project/<%= project.project_id %>">
                    Edit
                </a>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>