<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <% if (typeof errors !== 'undefined' && errors) { %>
    <ul class="notice">
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/edit-organization/<%= organization.organization_id %>" method="POST">
    <label for="name">Organization Name</label>

    <input
      type="text"
      id="name"
      name="name"
      value="<%= organization?.name || '' %>"
      maxlength="100"
      required
    />

    <label for="description">Description</label>

    <textarea
      id="description"
      name="description"
      required
    ><%= organization?.description || '' %></textarea>

    <label for="contact_email">Contact Email</label>

    <input
      type="email"
      id="contact_email"
      name="contact_email"
      value="<%= organization?.contact_email || '' %>"
      required
    />

    <label for="logo_filename">Logo Filename</label>

    <input
      type="text"
      id="logo_filename"
      name="logo_filename"
      value="<%= organization?.logo_filename || '' %>"
    />

    <button type="submit">Update Organization</button>
  </form>
</main>

<%- include('partials/footer') %>