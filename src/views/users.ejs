<%- include('partials/header') %>

<main>
    <h1>Registered Users</h1>

    <p>All users currently registered in the system.</p>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>
            <% for (const account of users) { %>
                <tr>
                    <td>
                        <%= account.first_name %> <%= account.last_name %>
                    </td>
                    <td>
                        <%= account.email %>
                    </td>
                    <td>
                        <%= account.role %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>

<%- include('partials/footer') %>